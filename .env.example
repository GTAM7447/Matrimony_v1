# Enterprise Security Configuration

# Authentication Mode
# Set to 'true' to use HttpOnly cookies (requires backend support)
# Set to 'false' to use client-side cookies (fallback)
VITE_USE_HTTPONLY_COOKIES=false

# Enable/Disable Security Features
VITE_ENABLE_AUDIT_LOGS=true
VITE_ENABLE_TOKEN_REFRESH=true
VITE_ENABLE_SECURITY_HEADERS=true

# API Endpoints
VITE_API_BASE_URL=https://mttl-v8-production.up.railway.app
VITE_AUTH_LOGIN_ENDPOINT=/api/v1/auth/login
VITE_AUTH_REFRESH_ENDPOINT=/api/v1/auth/refresh
VITE_AUTH_LOGOUT_ENDPOINT=/api/v1/auth/logout
VITE_AUDIT_LOG_ENDPOINT=/api/v1/audit/security-event

# Token Configuration (when using client-side cookies)
VITE_ACCESS_TOKEN_EXPIRY=900000
# 15 minutes in milliseconds
VITE_REFRESH_TOKEN_EXPIRY=604800000
# 7 days in milliseconds
VITE_TOKEN_REFRESH_BEFORE_EXPIRY=120000
# Refresh 2 minutes before expiry

# Security Headers (CSP)
VITE_CSP_ENABLED=true

# Development vs Production
# In production, set these via CI/CD pipeline or hosting provider
# Example: Vercel, Netlify allow you to set environment variables
